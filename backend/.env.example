# Copy this file to backend/.env and fill it in. On the host, set the same values as environment variables/secrets.

# Required in production: a long random string (e.g. `openssl rand -hex 32`).
SESSION_SECRET=change-me-to-a-long-random-string

# Public address of the frontend (e.g. your Netlify site). The backend accepts requests from it.
APP_URL=https://your-domain.example

# ---- Optional: email verification (off by default) ----
# By default any email-shaped address works and the user is signed in right after sign-up.
# To require a 6-digit code sent by email, set EMAIL_VERIFICATION=on and fill in SMTP below.
# EMAIL_VERIFICATION=on
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char App Password>
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Shuka <you@gmail.com>"

# Optional. Only needed to run the break-it tests against a production server; the tests send the same value.
# Leave unset in normal production use.
# TEST_AUTH_TOKEN=

# Frontend on another host (e.g. Netlify proxying /api to this backend): number of proxies in front
# of the app, so rate limits see the real client IP. 1 = Render/Fly only, 2 = Netlify + Render.
# TRUST_PROXY=1
# Extra sites allowed to send POST/PATCH requests (APP_URL is always allowed), comma-separated.
# ALLOWED_ORIGINS=https://my-site.netlify.app

# DATA_DIR=./data   # SQLite file, uploads/ and backups/ (must be a persistent disk in production)
# PORT=3000
