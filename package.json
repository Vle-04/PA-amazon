{
  "name": "shuka-marketplace",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["backend", "frontend"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "npm run setup -w backend && concurrently -k -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "seed": "npm run seed -w backend",
    "test:break-it": "npm run test:break-it -w backend",
    "test:email": "npm run test:email -w backend",
    "test:fk": "npm run test:fk -w backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
